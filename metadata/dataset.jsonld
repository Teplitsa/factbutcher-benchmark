{
  "@context": "https://schema.org/",
  "@type": "Dataset",
  "@id": "../",
  "name": "FactButcher Russian Fact-Checking Benchmark",
  "alternateName": "FactButcher Benchmark",
  "description": "A 423-row Russian-language evaluation dataset for claim verification, combining the 274-row FactButcher Human Benchmark derived from real Telegram user requests with 149 claims adapted from Provereno.Media fact-checking articles.",
  "url": "../",
  "version": "1.0.0",
  "dateModified": "2026-07-28",
  "creator": {
    "@type": "Organization",
    "name": "FactButcher"
  },
  "publisher": {
    "@type": "Organization",
    "name": "FactButcher"
  },
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "inLanguage": "ru",
  "keywords": [
    "fact-checking",
    "claim verification",
    "Russian",
    "benchmark",
    "natural language processing"
  ],
  "isAccessibleForFree": true,
  "citation": "../CITATION.cff",
  "isBasedOn": {
    "@type": "CreativeWork",
    "name": "Provereno.Media fact-checking articles",
    "url": "https://provereno.media/",
    "license": "https://creativecommons.org/licenses/by/4.0/"
  },
  "measurementTechnique": "../METHODOLOGY.md",
  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "claim",
      "description": "Russian-language claim presented for verification"
    },
    {
      "@type": "PropertyValue",
      "name": "gold_verdict",
      "description": "Primary human-reviewed reference verdict"
    },
    {
      "@type": "PropertyValue",
      "name": "acceptable_verdicts",
      "description": "All verdicts accepted by benchmark scoring"
    },
    {
      "@type": "PropertyValue",
      "name": "benchmark_component",
      "description": "Human Benchmark or Provereno.Media component"
    }
  ],
  "distribution": [
    {
      "@type": "DataDownload",
      "name": "FactButcher benchmark JSONL",
      "contentUrl": "../data/factbutcher_benchmark_v1.jsonl",
      "encodingFormat": "application/x-ndjson",
      "contentSize": "220480 bytes",
      "sha256": "517e46b55d60df9cb8081646e126e47c88e7969bdc3219f4d5a14627abb7377f"
    },
    {
